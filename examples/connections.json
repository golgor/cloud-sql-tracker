{
  "version": 1,
  "proxy_bin": "cloud-sql-proxy",
  "defaults": {
    "address": "127.0.0.1",
    "private_ip": false,
    "auto_iam_authn": false,
    "extra_args": [],
    "enabled": true
  },
  "connections": [
    {
      "id": "backend-dev",
      "name": "Backend Dev",
      "group": "backend",
      "instance": "acme-dev:europe-west1:backend-db-1",
      "port": 15432
    },
    {
      "id": "backend-prod",
      "name": "Backend Prod",
      "group": "backend",
      "instance": "acme-prod:europe-west1:backend-db-prod",
      "port": 15433
    },
    {
      "id": "fe-dev",
      "name": "FE Dev",
      "group": "fe",
      "instance": "acme-dev:europe-west1:frontend-db-1",
      "port": 15434
    },
    {
      "id": "fe-prod",
      "name": "FE Prod",
      "group": "fe",
      "instance": "acme-prod:europe-west1:frontend-db-replica",
      "port": 15435
    },
    {
      "id": "fe-rw-prod",
      "name": "FE RW Prod",
      "group": "fe",
      "instance": "acme-prod:europe-west1:frontend-db-main",
      "port": 15436
    },
    {
      "id": "iot-dev",
      "name": "IoT Dev",
      "group": "iot",
      "instance": "acme-iot-dev:europe-west1:iot-db-dev",
      "port": 15437
    },
    {
      "id": "iot-prod",
      "name": "IoT Prod",
      "group": "iot",
      "instance": "acme-iot-prod:europe-west1:iot-db-prod",
      "port": 15438
    }
  ]
}
